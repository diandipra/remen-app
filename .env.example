# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Di Vercel, isi nilai yang sama lewat Project Settings > Environment Variables.

# Email service account (dari file JSON kunci: field "client_email")
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com

# Private key service account (dari file JSON kunci: field "private_key")
# Saat ditempel di Vercel, biarkan apa adanya termasuk tanda \n di dalamnya.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID spreadsheet (bagian di URL antara /d/ dan /edit)
GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Kunci acak untuk sesi login sederhana (isi bebas, minimal 32 karakter)
APP_SESSION_SECRET=ganti-dengan-string-acak-panjang
